// The health app's Worker (rebuild Phase 0; CLAUDE.md "Phone app rebuild"): the app's
// static files from app/dist with the single-page-app fallback, and /api passed on to
// the engine on Google Cloud Run. Free plan only.
//
// Three secrets, set with `wrangler secret put` and NEVER written in this public file:
//   ACCESS_KEY  the owner's key; the phone sends it as `Authorization: Bearer ...`
//   ENGINE_KEY  sent to the engine as X-Engine-Key (the same value as Secret Manager's
//               health-engine-key)
//   ENGINE_URL  the Cloud Run address, kept out of the repo so it is not published
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "health",
  // The address is health.<account subdomain>.workers.dev. The subdomain
  // (lauscher-worker) is shared with Lauscher: changing it moves both apps.
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api reaches the Worker; every other path is a static file or index.html.
    "run_worker_first": ["/api/*", "/oura/*"]
  },
  // Rebuild Phase 4. ONE trigger: the daily data check at 04:15 UTC (it only reads; the
  // Worker keeps its answer in STATE). The free plan allows 5 triggers per account and
  // 10 ms of CPU per run (developers.cloudflare.com/workers/platform/limits, 2026-10-20);
  // Lauscher uses one. No trigger syncs the devices: the owner chose one sync a day at
  // the first app open (2026-10-19), and a trigger has no phone to give it the day.
  "triggers": {
    "crons": ["15 4 * * *"]
  },
  "vars": {
    // The second lock on the device syncs and the Oura login (src/index.ts). "true" only
    // at the switch-over (Phase 9), when the engine becomes the one background writer.
    "SYNC_ENABLED": "false",
    // The timer alerts (Web Push, src/alerts.ts): the VAPID subject and PUBLIC key, made by
    // scripts/vapid-keygen.mjs. The private key is the secret VAPID_PRIVATE_KEY, which that
    // script stores with `wrangler secret put` and never writes anywhere else. Empty: no
    // alerts (/api/push/key answers 503 push_not_configured).
    "VAPID_SUBJECT": "https://health.lauscher-worker.workers.dev",
    "VAPID_PUBLIC_KEY": "BNxc_lMtvnJdPY1I4FvX8Fj60RsJWzgqcPPK6h0ZfczdRYiCya8xdqzfr52cIAg_JadtP_eh4b1SvvGPy7_l30s"
  },
  // Rebuild Phase 6: one Durable Object keeps the push subscription and the waiting timer
  // alert, and its alarm sends the alert on the second. Free plan: SQLite-backed objects
  // only (durable-objects/platform/pricing, checked 2026-10-20).
  "durable_objects": {
    "bindings": [{ "name": "ALERTS", "class_name": "TimerAlerts" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TimerAlerts"] }],
  "kv_namespaces": [
    // health-state: the last data check. Free plan: 1,000 writes and 100,000 reads a day.
    { "binding": "STATE", "id": "84ff9d3f5e48499592ed8fe85b461359" }
  ]
}
