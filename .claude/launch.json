{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "health-offline",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "app.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501
    },
    {
      "name": "phone-app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@health/app", "exec", "vite", "--port", "5174", "--strictPort"],
      "port": 5174
    }
  ]
}
