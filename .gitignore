# Secrets — never commit API keys
# Glob, not the bare filename: an editor's .swp/.bak, or a hand-made
# secrets.toml.bak before an edit, carries exactly the same live credentials
# and the exact-match pattern did not cover any of them.
.streamlit/secrets.toml*
.env
.env.*

# Clinical input files — personal medical documents, never commit.
# The archive form is listed separately: `Input_files/` does not match a zip
# sitting beside it, so `git add -A` would have committed the MRI.
Input_files/
Input_files*.zip

# Virtual environment
venv/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Database files (local data, not for source control)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Local sync-throttle state (machine-specific, see services/clients/local_cache.py)
.sync_state.json

# OS junk
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Local scratch: debug HTML dumps, streamlit logs, screenshots.
tmp/
